# Copy to .env on the server and fill in real values. Never commit .env.
#
# Generate each token / password with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# (the password manager is the source of truth — paste from there, don't
# regenerate ad-hoc when adding stations or rebuilding the host)

# --- sensor-upload -----------------------------------------------------
# Comma-separated <station>:<token> pairs, no spaces.
# Station names match Pi hostnames (orc-<station>) with the orc- prefix
# stripped.
ORC_UPLOAD_TOKENS=sukabumi:REPLACE_ME,jakarta:REPLACE_ME

# --- timescale ---------------------------------------------------------
# Postgres password for the orc-grafana / orc-sensor-ingest containers.
TIMESCALE_PASSWORD=REPLACE_ME

# --- grafana -----------------------------------------------------------
# Admin password for the orc-grafana web UI (login user is orc-admin).
# Anonymous viewers do NOT need this; it's only for dashboard editing.
GRAFANA_ADMIN_PASSWORD=REPLACE_ME

# --- sheets-export -----------------------------------------------------
# ID of the Google Sheet that sensor readings are appended to. This is the
# /d/<ID>/ segment of the sheet URL.
#
# The sheet must be created BY A HUMAN — a service account has no Drive
# storage quota and cannot usefully own files — and then shared with the
# service-account email (the "client_email" field inside
# secrets/sheets-sa.json) with role Editor and "Notify people" UNCHECKED.
#
# Sheet setup: tab named "readings", header row A1:E1 =
# ts,station,sensor,metric,value, and File > Settings > Time zone set to UTC.
# See README.md § "Google Sheets export" for the full procedure.
SHEETS_SPREADSHEET_ID=REPLACE_ME

# live | dry-run | preview
#   live     append to the sheet, then mark exported     (production)
#   preview  neither append nor mark — "what would go out right now?"
#            Safe to run on the server.
#   dry-run  do NOT append, but DO mark exported. Local testing only: this
#            advances the cursor without writing anything, so it would
#            silently skip real data. NEVER set this on the AWS host.
EXPORT_MODE=live

# --- local development only --------------------------------------------
# Redirects the sensor-CSV bind mount away from host-absolute
# /var/orc/sensors so a dev machine can run the stack without sudo.
# Leave UNSET on the server — it defaults to the production path.
#ORC_SENSORS_HOST_DIR=./devdata/sensors
