data
data/
data/*
qgis
qgis/
qgis/*
rs-docs
rs-docs/
rs-docs/*
rainbow-sensing
rainbow-sensing/
rainbow-sensing/*

# Pi config files with real credentials (use placeholders in tracked files)
spring_2026_ID/pi/**/*.local

# Camera config credentials and local overrides
spring_2026_ID/camera/.env
spring_2026_ID/camera/**/*.local

# LiveORC server-side .env (contains ORC_UPLOAD_TOKENS)
spring_2026_ID/liveorc_server/.env

# LiveORC server-side cert dir — generated by bootstrap-cert.sh on the server.
# The PUBLIC cert is copied to pi/shared/etc/orc/sensor-upload-ca.pem and
# committed; the private key never leaves the server.
spring_2026_ID/liveorc_server/certs/

# LiveORC server-side Google service-account key for sheets-export. Server-
# local, same treatment as certs/. The key grants Editor on the export
# spreadsheet — there is no public half, so none of it is ever committed.
spring_2026_ID/liveorc_server/secrets/

# Local dev only: compose override redirecting host-absolute bind mounts, and
# the synthetic sensor CSVs it feeds to sensor-ingest.
spring_2026_ID/liveorc_server/docker-compose.override.yml
spring_2026_ID/liveorc_server/devdata/

# Python venv for doc tools (translation)
spring_2026_ID/docs/.venv/

# Python venv for the PDF/figure toolchain (pandoc, weasyprint, cairosvg).
# uv writes its own .gitignore inside it, but be explicit so a venv created
# another way is still ignored.
spring_2026_ID/docs/.venv-pdf/

# Python venvs anywhere in the repo (created for pyorc etc.)
.venv/
venv/
__pycache__/
*.pyc

# Build photos (large, not version controlled)
spring_2026_ID/build_photos/

# Survey exports (real GPS coordinates of deployment sites)
spring_2026_ID/survey_data/

# Bringup runtime data: input files (calibration JSON / geojson with real
# coords) + state / session logs / .env. Scripts and the data/state README
# placeholders themselves are tracked. NOTE: must explicitly re-include the
# bringup data/ dir because the top-of-file 'data/' rule shadows it.
!spring_2026_ID/sukabumi_bringup/data/
spring_2026_ID/sukabumi_bringup/data/*
!spring_2026_ID/sukabumi_bringup/data/README.md
spring_2026_ID/sukabumi_bringup/state/*
!spring_2026_ID/sukabumi_bringup/state/.gitkeep
spring_2026_ID/sukabumi_bringup/.env
spring_2026_ID/sukabumi_bringup/*.log

# Video files (large binaries)
*.mp4

# PDFs are tracked in git for easy access by non-technical users.
# Rebuild with: cd spring_2026_ID/docs && ./build_pdf.sh

# macOS Finder metadata
.DS_Store

# Sukabumi handoff folder (real GPS coords, .env with camera password)
spring_2026_ID/sukabumi_handoff/

# Ad-hoc sensor-pipeline diagnostic bundles (see pi/tools/orc_collect.sh)
orc_collect_*.txt

# Let's Encrypt cert copied out of the LiveORC container by
# enable-grafana-tls.sh. Server-local, same treatment as certs/.
spring_2026_ID/liveorc_server/certs-le/

# Any .env anywhere in the tree. There are explicit rules for several of these
# below/above, and spring_2026_ID/.env still slipped through — this repo is
# public and these files carry live credentials, so match the class, not paths.
.env
